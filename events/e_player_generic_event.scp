VERSION=X1

[events e_player_generic_event]
//Generic event to all players

ON=@Login
    say Welcome to OpenUO, a completely free world. Just enjoy and have fun!
    //ACCOUNT.LANG=CHT
    //RETURN 0

ON=@ExpChange
ARGN2=1
sysmessage Your Exp +<ARGN1>

ON=@ExpLevelChange
sysmessage Your Level changed to <ARGN1>

[eof]
