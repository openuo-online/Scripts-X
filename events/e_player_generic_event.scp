VERSION=X1

[events e_player_generic_event]
//Generic event to all players

ON=@Login
    say Welcome to OpenUO, a completely free world. Just enjoy and have fun!
    //ACCOUNT.LANG=CHT
    //RETURN 0

ON=@ExpChange
ARGN2=0
SYSMESSAGEUA 052,,,,Your Exp 经验值 added <ARGN1>.

ON=@ExpLevelChange
SYSMESSAGEUA 052,,,,Your Level 等级 changed to <LEVEL>.

[eof]
