VERSION=X1

[events e_player_generic_event]
//Generic event to all players

ON=@Login
    SAYUA 052,,,,Welcome to OpenUO, a completely free world. Just enjoy and have fun!
    //ACCOUNT.LANG=CHT
    //RETURN 0
    TAG.SKILLGAIN_BONUS_HOURS=12
    TAG.SKILLGAIN_BONUS_MULTIPLIER=2
    SYSMESSAGEUA ,,,,测试开发期，获得双倍练功。

ON=@AfterClick
if (<LEVEL> > 0) && (<EXP> > 0)
    LOCAL.CLICKMSGTEXT .= " Lv.<eval <LEVEL>>"
endif

ON=@ExpChange
ARGN2=0
SYSMESSAGEUA 88,,,,Your Exp 经验值 added <ARGN1>.

ON=@ExpLevelChange
SYSMESSAGEUA 88,,,,Your Level 等级 changed to <EVAL <LEVEL> + <ARGN1>>.

ON=@Hit
LOCAL.ITEMDAMAGECHANCE=3    //多少概率掉武器耐久

ON=@GetHit
LOCAL.ITEMDAMAGECHANCE=3    //多少概率掉盔甲、盾耐久

[eof]
