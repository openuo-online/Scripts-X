VERSION=X1

// MENU_PAGEGM -------------------------------------

[FUNCTION HelpPage]
// HelpPage is executed whenever someone presses the "HelpPage" button
DIALOG d_help_main

[MENU MENU_PAGEGM] // PAGEGM is executed whenever someone presses the "Page GM" button
OpenUO 主帮助菜单

ON=0 呼叫GM：向在线的服务器管理员发送通知。他们可以帮助你解决几乎所有游戏内的问题。
MENU MENU_PAGEGM_3

ON=0 网站菜单：提供各种网站链接列表。
MENU MENU_PAGEGM_2

ON=0 版本信息：显示此服务器运行的SPHERE版本。
VERSION

ON=0 服务器状态：显示此服务器的一些状态信息。
INFORMATION

ON=0 前往帮助室：将你传送到帮助服务台。
MENU MENU_PAGEGM_4

[MENU MENU_PAGEGM_2]
网站菜单
ON=0 OpenUO 官方网站：跳转到OpenUO官方主页。
WEBLINK https:\\openuo.online

[MENU MENU_PAGEGM_3]
GM呼叫菜单
ON=0 卡住了：如果你无法移动并需要GM协助，请使用此选项。
GMPAGE 卡住了
ON=0 物品问题：如果你遇到特定物品的问题，请使用此选项。
GMPAGE 物品问题
ON=0 BUG报告：如果你发现了想要向GM报告的BUG，请使用此选项。
GMPAGE BUG报告
ON=0 信息咨询：如果你需要关于游戏某部分的帮助信息，请使用此选项。
GMPAGE 信息咨询
ON=0 其他：用于上述未列出的任何问题。
GMPAGE 其他

[MENU MENU_PAGEGM_4]
你确定要传送到帮助室吗？你将被困在那里，直到GM将你传送回世界。
ON=0 是的，传送我过去！
//GOPLACE a_helpdesk
SERV.NEWITEM i_pagegm_teleport_delay
NEW.EQUIP

ON=0 不，我想留在这里。
SYSMESSAGE 帮助请求已取消。

[ITEMDEF i_pagegm_teleport_delay]
NAME=GM Page Delay Teleport
ID=i_handr_1
TYPE=T_EQ_SCRIPT
WEIGHT=0
LAYER=layer_special

ON=@Create
	ATTR=attr_invis|attr_decay
	MORE1=5
	MOREP=1495,1629,10,0	//Britain

ON=@Equip
	TIMER=1
	
ON=@Timer
	// Take the effect we would like.
	if ( <CONT> )
		if ( <MORE1> )
			CONT.message <eval <MORE1>>
			MORE1 -= 1
			TIMER=1
			return 1
		else
			CONT.go <MOREP>	
		endif
	endif
	// normal timer fall through is to delete the item
	remove
	return 1


