//****************************************************************************
// Global item events - custom modifications
//****************************************************************************

//还需要在源码里改成只有玩家的时候才生效
[EVENTS e_item_global]

// 拦截物品损坏事件，阻止耐久度降低
// ON=@Damage
//     // 返回 1 阻止耐久度损耗
//     SERV.LOG Item <NAME> (@Damage triggered, blocking durability loss)
//     RETURN 1

// 测试事件是否生效
// ON=@DClick
//     src.sayu Item <NAME> was double-clicked (baseid=<BASEID>) by <SRC.NAME>

// 你可以在这里添加其他全局物品事件
// 例如: @Create, @Equip, @UnEquip, @DropOn_Item 等

ON=@AfterClick
IF (<HITS> > 0) && (<MAXHITS> > 0)
    LOCAL.CLICKMSGTEXT .= " (<HITS>/<MAXHITS>)"
endif

[EOF]
