VERSION=X1

//===========================================================================
// 测试物品 - 对练拳套（自动回血）
//===========================================================================

[ITEMDEF i_test_platemail_gloves_healing]
ID=i_platemail_gloves
NAME=Training Gloves
TYPE=t_armor
FLIP=1
ARMOR=30
VALUE=1000
WEIGHT=2.0
CATEGORY=Test Items
SUBSECTION=Special Armor
DESCRIPTION=Training Gloves (Auto Healing)
CanUse=can_u_human|can_u_elf
ReqStr=30
TEVENTS=ei_equipitem

ON=@Create
   // 设置极高的耐久度，永不损坏
   HITPOINTS=9999
   MAXHITS=9999
   ATTR=attr_magic|attr_newbie
   COLOR=052
   RESCOLD=2
   RESENERGY=2
   RESFIRE=3
   RESPHYSICAL=5
   RESPOISON=3

ON=@Equip
   // 装备时启动定时器，每秒触发一次
   TIMER=1
   RETURN 0

ON=@UnEquip
   // 卸下装备时停止定时器
   TIMER=-1
   RETURN 0

ON=@DClick
   // 双击时调用 f_checkbonus 函数
   // SRC.f_checkbonus
   RETURN 0

ON=@Timer
   // 每秒检测佩戴者的血量
   IF (<CONT.ISCHAR>)
      // 如果不是满血状态，立即恢复满血
      IF ((<CONT.HITS> < <CONT.MAXHITS>) || (<CONT.MANA> < <CONT.MAXMANA>))
         CONT.HITS=<CONT.MAXHITS>
         CONT.MANA=<CONT.MAXMANA>
         // 可选：显示治疗效果
         CONT.EFFECT 3,i_fx_heal_effect,6,15,1
      ENDIF
      // 继续定时器，1秒后再次触发
      TIMER=1
   ELSE
      // 如果不在角色身上，停止定时器
      TIMER=-1
   ENDIF
   RETURN 1

[FUNCTION f_checkbonus]
SYSMESSAGE date:<EVAL <TAG0.SKILLGAIN_BONUS_DAY>> time:<EVAL <TAG0.SKILLGAIN_BONUS_STARTTIME>>
SYSMESSAGE hour:<EVAL <TAG0.SKILLGAIN_BONUS_HOURS>> x:<EVAL <TAG0.SKILLGAIN_BONUS_MULTIPLIER>>

[FUNCTION f_resetbonus]
TAG0.SKILLGAIN_BONUS_DAY=
TAG0.SKILLGAIN_BONUS_STARTTIME=

[function f_is_party]   //是不是队友
//party.members 队伍组员数量
//party.MEMBER.<x> 队伍组员UID,x是0-9索引
//party.ISSAMEPARTYOF <UID> 是不是同一个队伍
if (<isinparty>)
    if (<party.ISSAMEPARTYOF <ARGV0>>)
        return 1
    endif
endif
return 0

//===========================================================================
// 测试物品 - 治疗踏板（站上去每秒回血50点）
//===========================================================================

[ITEMDEF i_test_healing_plate]
ID=i_floor_stone_red
NAME=Healing Plate
TYPE=t_normal
ON=@Create
   ATTR=attr_move_never
   COLOR=049
ON=@Step
   // 当角色踩上踏板时触发
   IF (<SRC.ISPLAYER>)
      // 如果不是满血状态，恢复30点生命值
      IF (<SRC.HITS> < <SRC.MAXHITS>)
         LOCAL.HEAL=30
         // 确保不会超过最大生命值
         IF (<EVAL <SRC.HITS> + <LOCAL.HEAL>> > <SRC.MAXHITS>)
            SRC.HITS=<SRC.MAXHITS>
         ELSE
            SRC.HITS += <LOCAL.HEAL>
         ENDIF
         // 显示治疗效果
         SRC.EFFECT 3,i_fx_heal_effect,6,15,1
      ENDIF
   ENDIF
   RETURN 0
/
/===========================================================================
// 测试NPC - 训练假人（受到伤害固定为1点）
//===========================================================================

[CHARDEF c_test_training_dummy]
ID=c_man
NAME=Training Dummy
FOODTYPE=0
CAN=mt_nonmover
DAM=4,10
ARMOR=20

ON=@Create
   // 设置属性
   STR=100
   DEX=100
   INT=100
   MAXHITS=9999
   HITS=9999
   MAXSTAM=100
   STAM=100
   MAXMANA=100
   MANA=100
   // 设置为会主动攻击的怪物
   NPC=brain_monster
   // 设置攻击伤害为1点
   DAM=1,1
   // 设置战斗技能
   WRESTLING=80.0
   TACTICS=80.0
   MAGICRESISTANCE=50.0
   // 设置移动速度（0=不动，数值越大移动越快）
   // MOVERATE=0

ON=@GetHit
   // 拦截所有伤害，固定为1点
   ARGN1=1
   // 检查血量，如果低于100点就恢复满血
   IF (<HITS> < <MAXHITS>)
      HITS=<MAXHITS>
      // EFFECT 3,i_fx_heal_effect,6,15,1
   ENDIF
   // 反击攻击者
   IF (!<UID.<SRC.UID>.ISGM>)
      ATTACK <SRC>
   ENDIF
   RETURN 0

ON=@Hit
   // 被攻击时显示消息

   RETURN 0

[ITEMDEF i_bow_elven]
//Elven Bow
ID=i_bow
NAME=Elven Bow
DAM=19,24
SPEED=35
SKILL=Archery
REQSTR=80
RANGE=0,11
VALUE=1000
RESOURCES=100 i_log,100 i_ingot_iron
SKILLMAKE=Bowcraft 80
CATEGORY=Custom
SUBSECTION=WEAPON
DESCRIPTION=Elven Bow
ON=@Create
    COLOR=0237
    HITPOINTS={5500 6500}
ON=@Equip
    SRC.ARCHERY = <SRC.ARCHERY> + 10.0
    SRC.EVENTS +e_elven_bow
ON=@Unequip
    SRC.ARCHERY = <SRC.ARCHERY> - 10.0
    SRC.EVENTS -e_elven_bow

[EVENTS e_elven_bow]
ON=@Hit
IF (<ARGO>)
    REF1 = <ARGO>
    IF (<R10> < 1)
        // SAYU ***精 灵 祝 福***
        ARGN1 = <ARGN1> * 2
        SRC.EFFECT 3,i_fx_glow_spike,1,16,0
   ELIF (<R10> < 3)
      SRC.SPELLEFFECT s_harm,100.0,<UID>
   ENDIF
ENDIF