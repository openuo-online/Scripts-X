[ITEMDEF i_bow_elven]
//Elven Bow
ID=i_bow
NAME=Elven Bow
DAM=19,24
SPEED=35
SKILL=Archery
REQSTR=80
RANGE=0,11
VALUE=1000
RESOURCES=100 i_log,100 i_ingot_iron
SKILLMAKE=Bowcraft 80
CATEGORY=Custom
SUBSECTION=WEAPON
DESCRIPTION=Elven Bow
ON=@Create
    COLOR=0237
    HITPOINTS={5500 6500}
ON=@Equip
   //  SRC.ARCHERY = <SRC.ARCHERY> + 10.0
    SRC.EVENTS +e_elven_bow
ON=@Unequip
   //  SRC.ARCHERY = <SRC.ARCHERY> - 10.0
    SRC.EVENTS -e_elven_bow

[EVENTS e_elven_bow]
ON=@Hit
IF (<ARGO>)
    REF1 = <ARGO>
    IF (<R10> < 1)
        // SAYU ***精 灵 祝 福***
        ARGN1 = <ARGN1> * 3
        SRC.EFFECT 3,i_fx_glow_spike,1,16,0
   ELIF (<R10> < 3)
      SRC.SPELLEFFECT s_harm,100.0,<UID>
   ELIF (<R10> < 3)
      SRC.SPELLEFFECT s_lightning,100.0,<UID>
   ELIF (<R10> < 3)
      SRC.SPELLEFFECT s_flamestrike,100.0,<UID>
   ENDIF
ENDIF

[ITEMDEF i_nb_bokuto]
ID=i_bokuto
NAME=nb bokuto
TYPE=t_weapon_sword
DAM=33,55
RANGE=2
SPEED=200
TEVENTS=ei_equipitem
ON=@Create
   COLOR=0485
   HITPOINTS={8500 9500}
ON=@Equip
    SRC.EVENTS +e_nb_bokuto
ON=@Unequip
    SRC.EVENTS -e_nb_bokuto

[EVENTS e_nb_bokuto]
ON=@Hit
IF (<ARGO>)
   REF1 = <UID>
   SRC.SPELLEFFECT s_flamestrike,100.0,<UID>
   SRC.SPELLEFFECT s_poison,100.0,<UID>
   IF (<SRC.STAM> >= 50)
      SRC.STAM = <SRC.STAM> - 50
   ELSE
      SRC.STAM = 0
   ENDIF
   IF (<SRC.MANA> >= 50)
      SRC.MANA = <SRC.MANA> - 50
   ELSE
      SRC.MANA = 0
   ENDIF
   FORCHARS 5
      IF (!<ISPLAYER>) && (<SRC> != <UID>)
         SPELLEFFECT s_lightning,100.0,<REF1>
      ENDIF
   ENDFOR
ENDIF