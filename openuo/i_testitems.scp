VERSION=X1

//===========================================================================
// 测试物品 - 对练拳套（自动回血）
//===========================================================================

[ITEMDEF i_test_platemail_gloves_healing]
ID=i_platemail_gloves
NAME=Training Gloves
TYPE=t_armor
FLIP=1
ARMOR=30
VALUE=1000
WEIGHT=2.0
CATEGORY=Test Items
SUBSECTION=Special Armor
DESCRIPTION=Training Gloves (Auto Healing)
CanUse=can_u_human|can_u_elf
ReqStr=30
TEVENTS=ei_equipitem

ON=@Create
   // 设置极高的耐久度，永不损坏
   HITPOINTS=9999
   MAXHITS=9999
   ATTR=attr_magic|attr_newbie
   COLOR=05e5
   RESCOLD=2
   RESENERGY=2
   RESFIRE=3
   RESPHYSICAL=5
   RESPOISON=3

ON=@Equip
   // 装备时启动定时器，每秒触发一次
   TIMER=1
   RETURN 0

ON=@UnEquip
   // 卸下装备时停止定时器
   TIMER=-1
   RETURN 0

ON=@DClick
   // 双击时调用 f_checkbonus 函数
   SRC.f_checkbonus
   RETURN 1

ON=@Timer
   // 每秒检测佩戴者的血量
   IF (<CONT.ISCHAR>)
      // 如果不是满血状态，立即恢复满血
      IF (<CONT.HITS> < <CONT.MAXHITS>)
         CONT.HITS=<CONT.MAXHITS>
         // 可选：显示治疗效果
         CONT.EFFECT 3,i_fx_heal_effect,6,15,1
      ENDIF
      // 继续定时器，1秒后再次触发
      TIMER=1
   ELSE
      // 如果不在角色身上，停止定时器
      TIMER=-1
   ENDIF
   RETURN 1

[FUNCTION f_checkbonus]
SYSMESSAGE date:<EVAL <TAG0.SKILLGAIN_BONUS_DAY>> time:<EVAL <TAG0.SKILLGAIN_BONUS_STARTTIME>>
SYSMESSAGE hour:<EVAL <TAG0.SKILLGAIN_BONUS_HOURS>> x:<EVAL <TAG0.SKILLGAIN_BONUS_MULTIPLIER>>

[FUNCTION bonus]
f_checkbonus